@page "/"
@inject NavigationManager Nav

<PageTitle>Bienvenue</PageTitle>

<div class="start-canvas">
  <h1 class="title">Bienvenue dans <span>BlazorQuest</span></h1>
  <p class="subtitle">Choisissez une option pour commencer</p>

  @* 
    Composant AuthorizeView :
    Ce composant natif de Blazor permet d'afficher du contenu différent selon que l'utilisateur est connecté (Authorized) ou non (NotAuthorized).
    C'est ici qu'on gère l'accès aux fonctionnalités réservées aux membres.
  *@
  <AuthorizeView>
    <Authorized>
      <div class="grid3">
        <!-- Option 1 : Jouer (Nouvelle aventure) -->
        <button class="bigcard primary" @onclick='() => Nav.NavigateTo("play")'>
          <div class="emoji">⚔️</div>
          <div class="label">Jouer</div>
          <div class="hint">Lancer une nouvelle partie</div>
        </button>

        <!-- Option 2 : Historique -->
        <button class="bigcard secondary" @onclick='() => Nav.NavigateTo("historique")'>
          <div class="emoji">📜</div>
          <div class="label">Historique</div>
          <div class="hint">Voir mes anciennes parties</div>
        </button>

        <!-- Option 3 : Classement (Scores) -->
        <button class="bigcard secondary" @onclick='() => Nav.NavigateTo("classement")'>
          <div class="emoji">🏆</div>
          <div class="label">Scores</div>
          <div class="hint">Classement général</div>
        </button>
      </div>
    </Authorized>
    <NotAuthorized>
      <div class="grid3">
        <!-- 
          Si l'utilisateur n'est pas connecté, on lui propose de se connecter via Keycloak 
          ou de jouer en mode invité (sans sauvegarde de progression).
        -->
        <button class="bigcard primary" @onclick="Login">
          <div class="emoji">🔐</div>
          <div class="label">Se connecter</div>
          <div class="hint">Connexion via Keycloak</div>
        </button>



        <button class="bigcard secondary" @onclick="StartAsGuest">
          <div class="emoji">🎮</div>
          <div class="label">Continuer en tant qu’invité</div>
          <div class="hint">Jouer sans enregistrer</div>
        </button>
      </div>
    </NotAuthorized>
  </AuthorizeView>
</div>

@code {
  void Login() => Nav.NavigateTo("authentication/login");
  void StartAsGuest() => Nav.NavigateTo("/play");
}
